{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "campus-league-krx-feed",
  "main": "src/index.js",
  "compatibility_date": "2026-11-14",
  "workers_dev": true,
  "triggers": {
    "crons": ["* * * * *"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "KIS_COLLECTOR", "class_name": "KisCollector" }
    ],
    "code_update_strategy": {
      "mode": "immediate"
    }
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["KisCollector"] }
  ]
}
